# ===== 伺服器 =====
PORT=3000
# 對外網址（ngrok / Render 網址），用於 LINE 推播訊息裡的連結
PUBLIC_BASE_URL=http://localhost:3000

# ===== LINE Login（LIFF 所在的 channel）=====
LINE_LOGIN_CHANNEL_ID=
# 學生端與企業端各一個 LIFF App
LIFF_ID_STUDENT=
LIFF_ID_COMPANY=

# ===== LINE Messaging API（推播用的官方帳號）=====
LINE_CHANNEL_ACCESS_TOKEN=
# 官方帳號 Basic ID（例如 @123abcde），用於「加入好友」連結
LINE_OA_BASIC_ID=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Firestore =====
# 服務帳戶金鑰 JSON 檔路徑；留空則使用本機 data/db.json（示範模式）
GOOGLE_APPLICATION_CREDENTIALS=

# ===== 提醒排程 =====
# 部署到會休眠的平台（例如 Render 免費方案）時，設定這個密碼，
# 改由 cron-job.org 每天呼叫 https://你的網址/api/cron/reminders?key=這個密碼
CRON_SECRET=
# 每天幾點檢查即將截止的收藏職缺（cron 格式，台北時間）
REMINDER_CRON=0 9 * * *
# 截止前幾天開始提醒
REMINDER_DAYS_BEFORE=3
